---
import { NAV_LINKS, NAV_CTA_LABEL, BOOKING_URL } from '@lib/constants';
import Button from '@components/Button.astro';

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="nav-wrap container">
    <a class="brand" href="/">
      Second Line AI
    </a>

    <nav class="nav-links" aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={currentPath === link.href ? 'page' : undefined}
            class:list={{ 'is-active': currentPath === link.href }}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-cta">
      <Button href={BOOKING_URL} variant="primary" class="nav-btn" external>
        {NAV_CTA_LABEL}
      </Button>
    </div>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-panel"
      data-nav-toggle
    >
      <span class="visually-hidden">Open menu</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <div class="mobile-panel" id="mobile-panel" data-mobile-panel>
    <nav aria-label="Mobile">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <Button href={BOOKING_URL} variant="primary" size="large" class="mobile-cta" external>
      {NAV_CTA_LABEL}
    </Button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 500;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard);
  }

  .site-header.is-scrolled {
    background: rgba(20, 21, 15, 0.92);
    backdrop-filter: blur(10px);
    border-bottom-color: var(--color-line-on-dark);
  }

  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: 18px;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ivory);
    text-decoration: none;
    letter-spacing: 0.01em;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
  }

  .nav-links a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ivory-dim);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .nav-links a:hover,
  .nav-links a.is-active {
    color: var(--color-gold-light);
  }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  :global(.nav-btn) {
    padding: 11px 22px;
    font-size: 0.8125rem;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: 1px solid var(--color-line-on-dark);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-ivory);
    margin: 4px 0;
  }

  .mobile-panel {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: var(--color-charcoal);
    border-top: 1px solid var(--color-line-on-dark);
    padding: 8px 24px 24px;
  }

  .mobile-panel nav {
    display: flex;
    flex-direction: column;
  }

  .mobile-panel a {
    padding: 14px 0;
    color: var(--color-ivory-dim);
    text-decoration: none;
    font-size: 1rem;
    border-bottom: 1px solid var(--color-line-on-dark);
  }

  :global(.mobile-cta) {
    margin-top: 14px;
    width: 100%;
  }

  .site-header.is-open .mobile-panel {
    display: flex;
  }

  .site-header.is-open {
    background: var(--color-charcoal);
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }

    .nav-cta {
      display: none;
    }

    .nav-toggle {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  const setScrolled = () => {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 8);
  };

  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = header?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  document.querySelectorAll('[data-mobile-panel] a').forEach((link) => {
    link.addEventListener('click', () => {
      header?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      header?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
