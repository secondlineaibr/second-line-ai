---
/**
 * Canonical section wrapper. Tone set and rotation ported exactly from the
 * Blink reference build: flat (not gradient) fills, rotating through
 * Ivory (background) / Emerald (primary) / Secondary (light warm gray) /
 * Gold (accent) — Blink only ever uses ONE dark tone (primary), never a
 * second charcoal-style dark, so there's no "avoid two darks in a row"
 * bookkeeping here — just match the reference section by section.
 */
interface Props {
  tone?: 'ivory' | 'ivory-soft' | 'emerald' | 'secondary' | 'gold';
  center?: boolean;
  tight?: boolean;
  id?: string;
  class?: string;
}

const {
  tone = 'ivory',
  center = false,
  tight = false,
  id,
  class: className,
} = Astro.props;
---

<section
  id={id}
  class:list={[
    'section',
    `section--${tone}`,
    { 'section--center': center, 'section--tight': tight },
    className,
  ]}
>
  <div class="container">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-section-mobile);
  }

  @media (min-width: 640px) {
    .section {
      padding-block: var(--space-section-tablet);
    }
  }

  @media (min-width: 1024px) {
    .section {
      padding-block: var(--space-section-desktop);
    }
  }

  .section--tight {
    padding-block: var(--space-6);
  }

  .section--ivory {
    background: var(--color-ivory);
    color: var(--color-obsidian);
  }

  .section--ivory-soft {
    background: var(--color-ivory-soft);
    color: var(--color-obsidian);
  }

  .section--secondary {
    background: color-mix(in oklch, var(--color-secondary) 50%, var(--color-ivory));
    color: var(--color-obsidian);
  }

  .section--emerald {
    background: var(--color-emerald);
    color: var(--color-ivory-bright);
  }

  .section--gold {
    background: var(--color-gold);
    color: var(--color-obsidian);
  }

  .section--emerald :global(h1),
  .section--emerald :global(h2),
  .section--emerald :global(h3) {
    color: var(--color-ivory-bright);
  }

  .section--center {
    text-align: center;
  }
</style>
