---
import { FOOTER_LINKS, LEGAL_LINKS, CONTACT, BRAND_PROMISE, SITE_NAME, BOOKING_URL } from '@lib/constants';
import Icon from '@components/Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand-mark" href="/" aria-label="Second Line AI home">
          <span class="brand-ring" aria-hidden="true"><span class="brand-dot"></span></span>
          Second Line <span class="brand-accent">AI</span>
        </a>
        <p class="brand-promise">{BRAND_PROMISE}</p>
        <p class="brand-location">{CONTACT.location}</p>
      </div>

      <div>
        <h2>Explore</h2>
        <ul>
          {FOOTER_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h2>Talk With Us</h2>
        <ul>
          <li>
            <a href={CONTACT.phoneHref}><Icon name="phone" class="contact-icon" />{CONTACT.phoneDisplay}</a>
          </li>
          <li><a href={CONTACT.emailHref}>{CONTACT.email}</a></li>
          <li>
            <a href={BOOKING_URL} class="footer-cta" target="_blank" rel="noopener noreferrer">
              Book a Revenue Recovery Audit <Icon name="arrow-up-right" class="contact-icon" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} {SITE_NAME}</span>
      {LEGAL_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>

    <p class="footer-legal">
      Second Line AI provides revenue recovery and business-operations services for Louisiana
      HVAC contractors. Services do not include HVAC diagnosis, emergency services, legal
      advice, financial advice, or guaranteed business results. Capabilities vary based on
      configuration, third-party platforms, integrations, partner policies, and technical
      availability.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-obsidian);
    color: oklch(0.98 0.008 82 / 0.65);
    padding-block: var(--space-7) var(--space-4);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-6);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid oklch(0.98 0.008 82 / 0.15);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.375rem;
    color: var(--color-ivory-bright);
    text-decoration: none;
    margin-bottom: var(--space-3);
  }

  .brand-ring {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid oklch(0.68 0.13 82 / 0.7);
    flex-shrink: 0;
  }

  .brand-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-gold);
  }

  .brand-accent {
    color: var(--color-gold);
  }

  .brand-promise {
    max-width: 300px;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .brand-location {
    margin-top: var(--space-3);
    font-size: 0.75rem;
    /* No extra opacity here: .site-footer's base color is already
       oklch(.../0.65) alpha. An earlier version multiplied a second
       opacity on top of that base alpha and failed contrast as a
       result — inherit the base alpha once, not twice. */
  }

  .footer-grid h2 {
    color: var(--color-gold);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin-bottom: var(--space-3);
  }

  .footer-grid li {
    margin-bottom: 11px;
    font-size: 0.9rem;
  }

  .footer-grid a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: inherit;
  }

  .footer-grid a:hover {
    color: var(--color-gold);
  }

  .contact-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .footer-cta {
    color: var(--color-gold);
    font-weight: 700;
  }

  .footer-bottom {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: var(--space-4);
    font-size: var(--text-caption);
    /* Same fix as .brand-location above: no second opacity layer on
       top of .site-footer's base oklch alpha. */
  }

  .footer-bottom a {
    text-decoration: none;
    color: inherit;
  }

  .footer-bottom a:hover {
    color: var(--color-gold);
  }

  .footer-legal {
    font-size: 0.75rem;
    /* Same fix as .brand-location above: no second opacity layer on
       top of .site-footer's base oklch alpha — stacking one caused
       the exact same failure this comment used to warn about. */
    max-width: 900px;
    line-height: 1.7;
    margin-top: var(--space-4);
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
