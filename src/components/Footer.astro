---
import { NAV_LINKS, LEGAL_LINKS, CONTACT, BRAND_PROMISE, SITE_NAME } from '@lib/constants';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="brand-mark">{SITE_NAME}</div>
        <p class="brand-promise">{BRAND_PROMISE}</p>
      </div>

      <div>
        <h2>Navigate</h2>
        <ul>
          {NAV_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          {LEGAL_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h2>Contact</h2>
        <ul>
          <li><a href={CONTACT.emailHref}>{CONTACT.email}</a></li>
          <li><a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} {SITE_NAME}. All rights reserved.</span>
      <span>{CONTACT.location}</span>
    </div>

    <p class="footer-legal">
      Second Line AI provides revenue recovery and business-operations services for Louisiana
      HVAC contractors. Services do not include HVAC diagnosis, emergency services, legal
      advice, financial advice, or guaranteed business results. Capabilities vary based on
      configuration, third-party platforms, integrations, partner policies, and technical
      availability.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-charcoal);
    color: var(--color-ivory-dim);
    padding-block: var(--space-7) var(--space-4);
    border-top: 1px solid var(--color-line-on-dark);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-6);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-line-on-dark);
  }

  .brand-mark {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-ivory);
    margin-bottom: var(--space-2);
  }

  .brand-promise {
    max-width: 320px;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-gold-light);
    font-size: 1.0625rem;
  }

  .footer-grid h2 {
    color: var(--color-gold);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-3);
  }

  .footer-grid li {
    margin-bottom: 11px;
    font-size: 0.9rem;
  }

  .footer-grid a {
    text-decoration: none;
    color: inherit;
  }

  .footer-grid a:hover {
    color: var(--color-gold-light);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: var(--space-4);
    font-size: var(--text-caption);
    opacity: 0.65;
  }

  .footer-legal {
    font-size: 0.75rem;
    opacity: 0.55;
    max-width: 900px;
    line-height: 1.7;
    margin-top: var(--space-3);
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
