---
/**
 * Custom line-icon primitive — Project Magnolia section 5 requires custom,
 * thin-stroke, rounded-geometry icons rather than a generic icon pack.
 * Add new names here as later pages need them; keep stroke-width consistent.
 */
interface Props {
  name: 'phone' | 'arrow-right' | 'arrow-up-right' | 'check' | 'calendar' | 'compass' | 'chevron-down';
  class?: string;
  ariaHidden?: boolean;
}

const { name, class: className, ariaHidden = true } = Astro.props;

const paths: Record<Props['name'], string> = {
  phone:
    'M5 3.5h3.2l1.3 4-2 1.4a12.5 12.5 0 0 0 5.6 5.6l1.4-2 4 1.3V17c0 1.4-1.1 2.5-2.5 2.5A15.5 15.5 0 0 1 3.5 6c0-1.4 1.1-2.5 2.5-2.5Z',
  'arrow-right': 'M4 12h16M14 6l6 6-6 6',
  'arrow-up-right': 'M7 17 17 7M8 7h9v9',
  check: 'M4.5 12.5l4.5 4.5 10.5-11',
  calendar:
    'M4.5 6.5h15v13h-15v-13Zm0 4h15M8 3.5v4M16 3.5v4',
  compass:
    'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM14.5 9.5l-2 5-3-1 2-5 3 1Z',
  'chevron-down': 'M5 8.5 12 15.5 19 8.5',
};
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={ariaHidden ? 'true' : undefined}
>
  <path d={paths[name]} />
</svg>
