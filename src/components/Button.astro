---
/**
 * Matches Blink's ButtonLink/ghost-link exactly: sharp radius, bold text,
 * diagonal arrow that shifts on hover, lift + shadow. Blink drives the
 * primary button's fill color with a manual `light` prop per call site
 * (gold on a dark section, emerald elsewhere); here it's automatic via
 * section context instead — same rendered result, no call-site bookkeeping
 * to get wrong.
 */
import Icon from '@components/Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'base' | 'large';
  showArrow?: boolean;
  class?: string;
  external?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'base',
  showArrow = false,
  class: className,
  external = false,
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className]
  .filter(Boolean)
  .join(' ');
---

<Tag
  class={classes}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
  {showArrow && <Icon name="arrow-up-right" class="btn-icon" />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-height: 48px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.01em;
    padding-inline: 22px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    transition:
      transform var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard),
      background var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard);
  }

  .btn--large {
    min-height: 56px;
    padding-inline: 28px;
    font-size: 1rem;
  }

  .btn--primary {
    background: var(--color-emerald);
    color: var(--color-ivory-bright);
  }

  .btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  /* On a dark (emerald) section, the primary CTA flips to gold-filled —
     matching Blink's manual `light` prop, just driven by context instead. */
  :global(.section--emerald) .btn--primary {
    background: var(--color-gold);
    color: var(--color-obsidian);
  }

  .btn--secondary {
    background: transparent;
    border-color: var(--color-emerald);
    color: var(--color-emerald);
  }

  .btn--secondary:hover {
    border-color: var(--color-gold-deep);
    color: var(--color-gold-deep);
  }

  :global(.section--emerald) .btn--secondary {
    border-color: var(--color-ivory-bright);
    color: var(--color-ivory-bright);
    opacity: 0.85;
  }

  :global(.section--emerald) .btn--secondary:hover {
    opacity: 1;
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  .btn-icon {
    width: 16px;
    height: 16px;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .btn:hover .btn-icon {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover {
      transform: none;
    }
  }
</style>
