---
import Icon from '@components/Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'base' | 'large';
  showArrow?: boolean;
  class?: string;
  external?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'base',
  showArrow = false,
  class: className,
  external = false,
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className]
  .filter(Boolean)
  .join(' ');
---

<Tag
  class={classes}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
  {showArrow && <Icon name="arrow-right" class="btn-icon" />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
    padding: 16px 30px;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard),
      background var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard);
  }

  .btn--large {
    padding: 19px 36px;
    font-size: 1rem;
  }

  .btn--primary {
    background: var(--color-emerald);
    color: var(--color-ivory);
    box-shadow: var(--shadow-sm);
  }

  .btn--primary:hover {
    background: var(--color-emerald-bright);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .btn--secondary {
    background: transparent;
    border-color: var(--color-emerald);
    color: var(--color-emerald);
  }

  .btn--secondary:hover {
    background: var(--color-emerald);
    color: var(--color-ivory);
  }

  /* On dark section backgrounds, secondary buttons flip to ivory/gold */
  :global(.section--emerald) .btn--secondary,
  :global(.section--charcoal) .btn--secondary {
    border-color: var(--color-gold-light);
    color: var(--color-ivory);
  }

  :global(.section--emerald) .btn--secondary:hover,
  :global(.section--charcoal) .btn--secondary:hover {
    background: var(--color-gold-light);
    color: var(--color-obsidian);
  }

  .btn-icon {
    width: 18px;
    height: 18px;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .btn:hover .btn-icon {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover {
      transform: none;
    }
  }
</style>
