---
interface Props {
  as?: 'div' | 'li';
  class?: string;
}

const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['card', className]}>
  <slot />
</Tag>

<style>
  .card {
    background: var(--color-ivory-soft);
    border: 1px solid var(--color-line-on-light);
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-4);
  }

  :global(.section--emerald) .card,
  :global(.section--charcoal) .card {
    background: rgba(246, 241, 227, 0.05);
    border-color: var(--color-line-on-dark);
  }

  .card :global(h3) {
    font-size: 1.125rem;
    margin-bottom: var(--space-1);
  }

  .card :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
